{
  "entities": {
    "registered_users": {
      "title": "Registered User",
      "description": "Information about users who have signed in with Google",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User Google email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "User avatar photo URL" },
        "firstLoginAt": { "type": "number", "description": "Timestamp of first login" },
        "lastLoginAt": { "type": "number", "description": "Timestamp of last login" },
        "workspaceCount": { "type": "number", "description": "Number of workspaces created" }
      },
      "required": ["uid", "email", "firstLoginAt", "lastLoginAt"]
    },
    "workspaces": {
      "title": "User Workspace",
      "description": "Bio link workspaces/projects created by a user",
      "properties": {
        "id": { "type": "string", "description": "Workspace ID" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "name": { "type": "string", "description": "Workspace project name" },
        "username": { "type": "string", "description": "Public URL slug" },
        "profile": { "type": "object", "description": "Profile data and theme" },
        "links": { "type": "array", "description": "Array of bio links" },
        "analytics": { "type": "object", "description": "Analytics events and metrics" },
        "createdAt": { "type": "number", "description": "Creation timestamp" },
        "updatedAt": { "type": "number", "description": "Update timestamp" }
      },
      "required": ["id", "userId", "name", "username", "createdAt", "updatedAt"]
    }
  }
}
